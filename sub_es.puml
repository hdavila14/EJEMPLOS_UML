@startuml subescenarios
left to right direction
actor Cliente
rectangle "Sistema" {
    usecase "Realizar reserva" as UC1
    usecase "Verificar saldo" as UC2
    usecase "Rechazar" as UC3
    usecase "Aprobar" as UC4
}
actor Taquilla
Cliente -down-> UC1
UC1 ..> UC2 : <<include>>
UC3 ..> UC1 : <<extend>> \n [insuficiente]
UC4 ..> UC1 : <<extend>> \n [suficiente]
UC1 --> Taquilla
@enduml